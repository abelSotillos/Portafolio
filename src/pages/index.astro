---
// pages/desktop.astro  ← ejemplo de uso completo
import Taskbar from "../components/Taskbar.astro";
import DraggableWindow from "../components/DraggableWindow.astro";

// Contenido de cada ventana como componente .astro
import Portafolio from "../components/windows/Portafolio.astro";
import TerminalWindow from "../components/windows/TerminalWindow.astro";
import DockerWindow from "../components/windows/DockerWindow.astro";
import AngularWindow from "../components/windows/AngularWindow.astro";
import SpringBootWindow from "../components/windows/SpringBootWindow.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Escritorio</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        background: hsl(222 47% 10%);
        overflow: hidden;
      }
      body {
        background-image: url('../assets/zorro-fondo2.png');
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }
    </style>
  </head>
  <body>
    <!--
    Cada DraggableWindow envuelve un componente de contenido.
    - El id debe coincidir con el id definido en taskbar.types.ts
    - initialHidden=true → la ventana solo se muestra al pulsar en el menú inicio
    - Sin initialHidden  → la ventana aparece al cargar la página
  -->

     <DraggableWindow
      id="portafolio"
      title="about-me.txt"
      lucideIcon="User"
      width={400}
      height={300}
      initialX={200}
      initialY={140}
    >
      <Portafolio/>
    </DraggableWindow>

    <DraggableWindow
      id="app-terminal"
      title="Terminal"
      lucideIcon="Terminal"
      width={520}
      height={340}
      initialX={120}
      initialY={80}
      initialHidden
    >
      <TerminalWindow />
    </DraggableWindow>

    <DraggableWindow
      id="app-docker"
      title="Docker"
      lucideIcon="Sailboat"
      width={560}
      height={420}
      initialX={160}
      initialY={60}
      initialHidden
    >
      <DockerWindow />
    </DraggableWindow>

    <DraggableWindow
      id="app-angular"
      title="Angular"
      lucideIcon="Component"
      width={580}
      height={420}
      initialX={180}
      initialY={70}
      initialHidden
    >
      <AngularWindow />
    </DraggableWindow>

    <DraggableWindow
      id="app-springboot"
      title="Spring Boot"
      lucideIcon="Leaf"
      width={580}
      height={420}
      initialX={200}
      initialY={80}
      initialHidden
    >
      <SpringBootWindow />
    </DraggableWindow>

    <!-- Barra de tareas + menú inicio -->
    <Taskbar />
  </body>
</html>
