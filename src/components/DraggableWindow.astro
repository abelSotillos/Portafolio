---
// DraggableWindow.astro
import {
  FolderOpen,
  Terminal,
  Globe,
  FileText,
  Calculator,
  Music,
  Search,
  Power,
  User,
  Sailboat,
} from "@lucide/astro/icons/index";
import { Minus, Square, X } from "@lucide/astro/icons/index";

interface Props {
  id: string;
  title: string;
  lucideIcon?: string;
  width?: number;
  height?: number;
  initialX?: number;
  initialY?: number;
  /** Si es true, la ventana empieza oculta y el menú inicio la muestra */
  initialHidden?: boolean;
}

const {
  id,
  title,
  lucideIcon = "",
  width = 400,
  height = 300,
  initialX = 120,
  initialY = 80,
  initialHidden = false,
} = Astro.props;

const iconMap: Record<string, any> = {
  FolderOpen,
  Terminal,
  Globe,
  FileText,
  Calculator,
  Music,
  User,
  Sailboat,
};
---

<div
  id={id}
  class="win-window"
  data-win-emoji={lucideIcon}
  data-win-title={title}
  style={[
    `width:${width}px`,
    `height:${height}px`,
    `left:${initialX}px`,
    `top:${initialY}px`,
    initialHidden ? "display:none" : "",
  ]
    .filter(Boolean)
    .join(";")}
>
  <!-- Titlebar -->
  <div class="win-titlebar" data-drag-handle>
    <div class="win-titlebar-left">
      <span class="win-icon">
        {
          () => {
            const Icon = iconMap[lucideIcon];
            return Icon ? <Icon size={26} color="hsl(217 91% 65%)" /> : "";
          }
        }</span
      >
      <span class="win-title">{title}</span>
    </div>
    <div class="win-controls">
      <button class="win-btn win-minimize" title="Minimizar">
        <Minus size={16} color="hsl(215 20% 65%)" />
      </button>
      <button class="win-btn win-maximize" title="Maximizar">
        <Square size={15} color="hsl(215 20% 65%)" />
      </button>
      <button class="win-btn win-close" title="Cerrar">
        <X size={16} color="hsl(0 84% 60%)" />
      </button>
    </div>
  </div>

  <!-- Contenido: slot → componente Astro hijo -->
  <div class="win-content">
    <slot />
  </div>

  <!-- Handle de redimensión -->
  <div class="win-resize-handle" data-resize-handle></div>
</div>

<style>
  @keyframes win-open {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  @keyframes win-close-anim {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.9) translateY(12px);
    }
  }

  .win-window {
    position: fixed;
    display: flex;
    flex-direction: column;
    background-color: hsl(222 47% 14% / 0.85);
    border: 2px solid hsl(217 33% 25% / 0.6);
    border-radius: 8px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.25),
      0 2px 8px rgba(0, 0, 0, 0.15);
    font-family: "Segoe UI", system-ui, sans-serif;
    min-width: 200px;
    min-height: 120px;
    overflow: hidden;
    z-index: 1000;
    user-select: none;
    max-height: calc(100vh - 45px);
    animation: win-open 0.2s cubic-bezier(0.34, 1.3, 0.64, 1) both;
  }

  .win-window.is-dragging {
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.35),  
      0 4px 16px rgba(0, 0, 0, 0.2);
    opacity: 0.97;
  }

  .win-window.is-maximized {
    border-radius: 0 !important;
    border: none !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .win-window:not(.is-focused) .win-titlebar {
    background-color: hsl(217 33% 12%);
    opacity: 0.85;
  }

  /* ── Titlebar ── */
  .win-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: hsl(217 33% 17%);
    color: white;
    padding: 0 0 0 10px;
    height: 36px;
    cursor: grab;
    flex-shrink: 0;
    transition:
      background-color 0.25s,
      opacity 0.25s;
  }
  .win-titlebar:active {
    cursor: grabbing;
  }

  .win-titlebar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    overflow: hidden;
  }

  .win-icon {
    font-size: 15px;
    flex-shrink: 0;
  }
  .win-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win-controls {
    display: flex;
    height: 100%;
    flex-shrink: 0;
  }

  .win-btn {
    width: 46px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.1s;
  }
  .win-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .win-close:hover {
    background: #e81123 !important;
  }
  .win-close:hover :global(svg) {
    color: white !important;
  }

  /* ── Contenido ── */
  .win-content {
    flex: 1;
    overflow: auto;
    background-color: hsl(222 47% 14%);
    color: hsl(215 20% 75%);
    min-height: 0;
  }

  /* ── Resize handle ── */
  .win-resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 16px;
    height: 16px;
    cursor: se-resize;
    background: linear-gradient(
      135deg,
      transparent 50%,
      rgba(0, 120, 212, 0.3) 50%
    );
  }
  .win-resize-handle:hover {
    background: linear-gradient(
      135deg,
      transparent 50%,
      rgba(0, 120, 212, 0.55) 50%
    );
  }
</style>

<script define:vars={{ id, title, lucideIcon }}>
  (function () {
    const win = document.getElementById(id);
    if (!win) return;

    let isDragging = false,
      isResizing = false;
    let startX = 0,
      startY = 0,
      startL = 0,
      startT = 0,
      startW = 0,
      startH = 0;
    let isMaximized = false;
    let saved = { left: "", top: "", width: "", height: "" };

    const titlebar = win.querySelector("[data-drag-handle]");
    const resizeHandle = win.querySelector("[data-resize-handle]");
    const btnMin = win.querySelector(".win-minimize");
    const btnMax = win.querySelector(".win-maximize");
    const btnClose = win.querySelector(".win-close");

    if (!titlebar || !resizeHandle || !btnMin || !btnMax || !btnClose) return;

    const emit = (name, extra) =>
      document.dispatchEvent(
        new CustomEvent(name, {
          bubbles: true,
          detail: Object.assign({ id, title, lucideIcon }, extra ?? {}),
        }),
      );

    const getScreen = () => ({ w: window.innerWidth, h: window.innerHeight });
    const clamp = (x, y, w, h) => {
      const s = getScreen();
      return {
        x: Math.max(0, Math.min(x, s.w - w)),
        y: Math.max(0, Math.min(y, s.h - h - 52)),
      };
    };

    function focus() {
      const all = document.querySelectorAll(".win-window");
      let maxZ = 1000;
      all.forEach((w) => {
        const z = parseInt(getComputedStyle(w).zIndex) || 1000;
        if (z > maxZ) maxZ = z;
      });
      win.style.zIndex = String(maxZ + 1);
      all.forEach((w) => w.classList.remove("is-focused"));
      win.classList.add("is-focused");
      emit("win-focus");
    }

    win.addEventListener("mousedown", focus);
    // Solo marcar como focusada si está visible al inicio
    if (win.style.display !== "none") win.classList.add("is-focused");

    // ── Drag ──
    titlebar.addEventListener("mousedown", (e) => {
      if (e.target.closest(".win-controls") || isMaximized) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      startL = win.offsetLeft;
      startT = win.offsetTop;
      win.classList.add("is-dragging");
      e.preventDefault();
    });

    document.addEventListener("mousemove", (e) => {
      if (isDragging) {
        const p = clamp(
          startL + e.clientX - startX,
          startT + e.clientY - startY,
          win.offsetWidth,
          win.offsetHeight,
        );
        win.style.left = `${p.x}px`;
        win.style.top = `${p.y}px`;
      }
      if (isResizing) {
        win.style.width = `${Math.max(200, startW + e.clientX - startX)}px`;
        win.style.height = `${Math.max(120, startH + e.clientY - startY)}px`;
      }
    });

    document.addEventListener("mouseup", () => {
      isDragging = false;
      isResizing = false;
      win.classList.remove("is-dragging");
    });

    // ── Resize ──
    resizeHandle.addEventListener("mousedown", (e) => {
      if (isMaximized) return;
      isResizing = true;
      startX = e.clientX;
      startY = e.clientY;
      startW = win.offsetWidth;
      startH = win.offsetHeight;
      e.preventDefault();
      e.stopPropagation();
    });

    // ── Botones ──
    btnMin.addEventListener("click", () => {
      win.style.display = "none";
      emit("win-minimize");
    });

    btnMax.addEventListener("click", () => {
      const s = getScreen();
      if (!isMaximized) {
        saved = {
          left: win.style.left,
          top: win.style.top,
          width: win.style.width,
          height: win.style.height,
        };
        win.style.left = "0";
        win.style.top = "0";
        win.style.width = `${s.w}px`;
        win.style.height = `${s.h - 44}px`;
        win.classList.add("is-maximized");
        isMaximized = true;
      } else {
        Object.assign(win.style, saved);
        win.classList.remove("is-maximized");
        isMaximized = false;
      }
    });

    btnClose.addEventListener("click", () => {
      emit("win-close");
      win.style.animation = "win-close-anim .15s ease forwards";
      setTimeout(() => {
        win.style.animation = "";
        win.style.display = "none";
        emit("win-close"); // ← taskbar quita el botón de la barra
      }, 150);
    });

    titlebar.addEventListener("dblclick", (e) => {
      if (!e.target.closest(".win-controls")) btnMax.click();
    });

    window.addEventListener("resize", () => {
      if (isMaximized) {
        const s = getScreen();
        win.style.width = `${s.w}px`;
        win.style.height = `${s.h - 44}px`;
      } else {
        const p = clamp(
          win.offsetLeft,
          win.offsetTop,
          win.offsetWidth,
          win.offsetHeight,
        );
        win.style.left = `${p.x}px`;
        win.style.top = `${p.y}px`;
      }
    });

    // Registrar en la taskbar
    requestAnimationFrame(() => emit("win-register"));
  })();
</script>
