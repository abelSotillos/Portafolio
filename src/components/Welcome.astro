---
import { Minus, Square, User, X } from '@lucide/astro';
import background from '../assets/zorro-fondo2.png';
import DraggableWindow from './DraggableWindow.astro';
import NavBar from './NavBar.astro';
---
<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<NavBar/>
		<DraggableWindow title="about_me.txt" width={500} height={350} initialX={150} initialY={100}>
			<h1>Abel Sotillos Cuenca</h1>
			<p>Full Stack Developer</p>
		</DraggableWindow>
	</main>
</div>

<style>
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;	
		object-fit: cover;
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
	}

	main {
		height: 100%; 
		display: flex;
		justify-content: center;
		align-content: center;
    	flex-wrap: wrap;
	}

	h1{
		color:hsl(210 40% 98%);
		font-weight: 700;
		font-size: 1.875rem;
    	line-height: 2.25rem;
		text-shadow: 0 0 20px hsl(217 91% 60% / .5);
		margin: 0;
	}
	p{
		color: hsl(217 91% 60%);
		font-size: 0.875rem;
    	line-height: 1.25rem;
		margin: 0;
	}
</style>
