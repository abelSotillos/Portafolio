---
// windows/ExplorerWindow.astro
const files = [
  { name: "Documentos",  icon: "📁", modified: "hoy" },
  { name: "Imágenes",    icon: "🖼️",  modified: "ayer" },
  { name: "Descargas",   icon: "📥", modified: "hace 2 días" },
  { name: "notas.txt",   icon: "📄", modified: "hoy" },
  { name: "proyecto.zip",icon: "🗜️", modified: "hace 1 semana" },
];
---

<div class="explorer">
  <div class="explorer-toolbar">
    <button class="exp-btn">← Atrás</button>
    <button class="exp-btn">→ Adelante</button>
    <div class="exp-path">
      <span>📍</span>
      <span>Este equipo / Inicio</span>
    </div>
  </div>

  <ul class="explorer-list">
    {files.map((file) => (
      <li class="exp-item">
        <span class="exp-icon">{file.icon}</span>
        <span class="exp-name">{file.name}</span>
        <span class="exp-date">{file.modified}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .explorer {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: "Segoe UI", system-ui, sans-serif;
  }

  .explorer-toolbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: hsl(217 33% 16%);
    border-bottom: 1px solid hsl(217 33% 22% / .6);
    flex-shrink: 0;
  }

  .exp-btn {
    padding: 4px 10px;
    background: hsl(217 33% 20%);
    border: 1px solid hsl(217 33% 28% / .5);
    border-radius: 5px;
    color: hsl(215 20% 65%);
    font-size: 12px;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .exp-btn:hover { background: hsl(217 33% 25%); color: #fff; }

  .exp-path {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    padding: 4px 10px;
    background: hsl(217 33% 12%);
    border: 1px solid hsl(217 33% 22% / .4);
    border-radius: 5px;
    font-size: 12px;
    color: hsl(215 20% 60%);
  }

  .explorer-list {
    list-style: none;
    margin: 0;
    padding: 6px;
    overflow-y: auto;
    flex: 1;
  }

  .exp-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background .12s;
  }
  .exp-item:hover { background: hsl(217 33% 20% / .7); }

  .exp-icon { font-size: 16px; flex-shrink: 0; }
  .exp-name { flex: 1; font-size: 13px; color: hsl(215 20% 80%); }
  .exp-date { font-size: 11px; color: hsl(215 20% 40%); }
</style>
