        <span class="fn">assertThatThrownBy</span>(() ->
            userService.<span class="fn">findById</span>(<span class="val">99L</span>))
            .<span class="fn">isInstanceOf</span>(
                <span class="tp">ResourceNotFoundException</span>.class);
    }
}`)}

      <h3>Test de integración de controller</h3>
      ${codeBlock("UserControllerIT.java", `<span class="an">@SpringBootTest</span>
<span class="an">@AutoConfigureMockMvc</span>
<span class="kw">class</span> <span class="tp">UserControllerIT</span> {

    <span class="an">@Autowired</span>
