    "dto": () => `
      <h2>DTOs (Data Transfer Objects)</h2>
      <p>Los DTOs separan la representación de la API de las entidades internas. Usa <code>record</code> de Java 16+ para DTOs inmutables.</p>

      <h3>DTOs con Records</h3>
      ${codeBlock("UserDTO.java", `<span class="kw">package</span> com.example.miapp.dto;

<span class="cm">// DTO de respuesta</span>
<span class="kw">public record</span> <span class="tp">UserDTO</span>(
    <span class="tp">Long</span> id,
    <span class="tp">String</span> name,
    <span class="tp">String</span> email
) {}`)}

      ${codeBlock("CreateUserDTO.java", `<span class="kw">import</span> jakarta.validation.constraints.*;

<span class="cm">// DTO de creación con validaciones</span>
<span class="kw">public record</span> <span class="tp">CreateUserDTO</span>(

    <span class="an">@NotBlank</span>(message = <span class="str">"El nombre es obligatorio"</span>)
    <span class="an">@Size</span>(min = <span class="val">2</span>, max = <span class="val">100</span>)
    <span class="tp">String</span> name,

    <span class="an">@NotBlank</span>
    <span class="an">@Email</span>(message = <span class="str">"Email no válido"</span>)
    <span class="tp">String</span> email,

    <span class="an">@Size</span>(min = <span class="val">8</span>, message = <span class="str">"Mínimo 8 caracteres"</span>)
    <span class="tp">String</span> password
) {}`)}

      <h3>Mapper entre Entity y DTO</h3>
      ${codeBlock("UserMapper.java", `<span class="an">@Component</span>
<span class="kw">public class</span> <span class="tp">UserMapper</span> {

    <span class="kw">public</span> <span class="tp">UserDTO</span> <span class="fn">toDTO</span>(<span class="tp">User</span> user) {
        <span class="kw">return new</span> <span class="tp">UserDTO</span>(
            user.<span class="fn">getId</span>(),
            user.<span class="fn">getName</span>(),
            user.<span class="fn">getEmail</span>()
        );
    }

    <span class="kw">public</span> <span class="tp">User</span> <span class="fn">toEntity</span>(<span class="tp">CreateUserDTO</span> dto) {
        <span class="kw">return</span> <span class="tp">User</span>.<span class="fn">builder</span>()
            .<span class="fn">name</span>(dto.<span class="fn">name</span>())
            .<span class="fn">email</span>(dto.<span class="fn">email</span>())
            .<span class="fn">build</span>();
    }
}`)}

      <div class="sb-tip">Los <strong>records</strong> de Java son ideales para DTOs: inmutables, con <code>equals()</code>, <code>hashCode()</code> y <code>toString()</code> generados automáticamente.</div>
    `,

    "config": () => `
