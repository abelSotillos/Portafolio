    <span class="an">@Bean</span>
    <span class="kw">public</span> <span class="tp">WebMvcConfigurer</span> <span class="fn">corsConfigurer</span>() {
        <span class="kw">return new</span> <span class="tp">WebMvcConfigurer</span>() {
            <span class="an">@Override</span>
            <span class="kw">public void</span> <span class="fn">addCorsMappings</span>(
                    <span class="tp">CorsRegistry</span> registry) {
                registry.<span class="fn">addMapping</span>(<span class="str">"/api/**"</span>)
                    .<span class="fn">allowedOrigins</span>(<span class="str">"http://localhost:4200"</span>)
