<div class="sb" id="springboot-root">

  <!-- ── SIDEBAR ── -->
  <div class="sb-sidebar" id="sb-sidebar">
    <button class="sb-link active" data-section="getting-started">Primeros pasos</button>
    <button class="sb-link" data-section="project">Estructura</button>
    <button class="sb-link" data-section="controllers">Controllers</button>
    <button class="sb-link" data-section="services">Services</button>
    <button class="sb-link" data-section="repositories">Repositories</button>
    <button class="sb-link" data-section="entities">Entities</button>
    <button class="sb-link" data-section="dto">DTOs</button>
    <button class="sb-link" data-section="config">Configuración</button>
    <button class="sb-link" data-section="security">Security</button>
    <button class="sb-link" data-section="testing">Testing</button>
  </div>

  <!-- ── CONTENT ── -->
  <div class="sb-content" id="sb-content">
    <!-- filled by JS -->
  </div>

</div>

<!-- ═══════════════════════════════════════════════ -->
<!-- STYLES                                          -->
<!-- ═══════════════════════════════════════════════ -->
<style>
  .sb {
    display: flex;
    flex-direction: row;
    height: 100%;
    font-family: "Segoe UI", system-ui, sans-serif;
    background: hsl(222 47% 11%);
    color: hsl(215 20% 80%);
    font-size: 13px;
  }
  .sb :global(*) {
    scrollbar-width: thin;
    scrollbar-color: hsl(217 33% 25%) transparent;
  }
  .sb :global(*::-webkit-scrollbar) { width: 6px; height: 6px; }
  .sb :global(*::-webkit-scrollbar-track) { background: transparent; }
  .sb :global(*::-webkit-scrollbar-thumb) {
    background: hsl(217 33% 25%);
    border-radius: 3px;
  }
  .sb :global(*::-webkit-scrollbar-thumb:hover) {
    background: hsl(217 33% 35%);
  }

  /* ── Sidebar ── */
  .sb-sidebar {
    width: 130px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 6px;
    background: hsl(217 33% 12%);
    border-right: 1px solid hsl(217 33% 22% / .4);
    overflow-y: auto;
  }
  .sb-link {
    padding: 6px 10px;
    background: transparent;
    border: none;
    border-radius: 5px;
    color: hsl(215 20% 55%);
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .sb-link:hover { background: hsl(217 33% 18%); color: hsl(215 20% 75%); }
  .sb-link.active { background: hsl(120 55% 45% / .15); color: hsl(120 55% 62%); }

  /* ── Content ── */
  .sb-content {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
    line-height: 1.6;
  }
  .sb-content :global(h2) {
    color: hsl(120 55% 55%);
    font-size: 16px;
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sb-content :global(h3) {
    color: hsl(120 55% 62%);
    font-size: 13px;
    margin: 16px 0 6px;
  }
  .sb-content :global(h3:first-child) { margin-top: 0; }
  .sb-content :global(p) {
    margin: 4px 0;
    font-size: 12px;
    color: hsl(215 20% 60%);
    line-height: 1.5;
  }
  .sb-content :global(code) {
    background: hsl(217 33% 18%);
    padding: 1px 5px;
    border-radius: 3px;
    font-family: "Cascadia Code", "Fira Code", monospace;
    font-size: 11px;
    color: hsl(215 20% 80%);
  }
  .sb-content :global(.sb-code-block) {
    background: hsl(0 0% 3%);
    border: 1px solid hsl(0 0% 14%);
    border-radius: 6px;
    margin: 8px 0;
    overflow: hidden;
    position: relative;
  }
  .sb-content :global(.sb-code-label) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 12px;
    background: hsl(0 0% 7%);
    border-bottom: 1px solid hsl(0 0% 12%);
    font-size: 10px;
    color: hsl(215 20% 40%);
    font-family: "Cascadia Code", "Fira Code", monospace;
  }
  .sb-content :global(.sb-copy-btn) {
    background: none;
    border: none;
    color: hsl(215 20% 35%);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 10px;
    transition: color .15s, background .15s;
  }
  .sb-content :global(.sb-copy-btn:hover) {
    color: hsl(120 55% 62%);
    background: hsl(217 33% 18%);
  }
  .sb-content :global(.sb-copy-btn.copied) { color: hsl(120 55% 55%); }
  .sb-content :global(.sb-code-pre) {
    padding: 10px 12px;
    font-family: "Cascadia Code", "Fira Code", monospace;
    font-size: 11.5px;
    line-height: 1.5;
    color: hsl(215 20% 80%);
    overflow-x: auto;
    white-space: pre;
    margin: 0;
  }
  .sb-content :global(.sb-code-pre .kw) { color: hsl(280 60% 70%); }
  .sb-content :global(.sb-code-pre .an) { color: hsl(120 55% 62%); }
  .sb-content :global(.sb-code-pre .str) { color: hsl(30 90% 60%); }
  .sb-content :global(.sb-code-pre .fn) { color: hsl(120 55% 68%); }
  .sb-content :global(.sb-code-pre .cm) { color: hsl(215 20% 40%); font-style: italic; }
  .sb-content :global(.sb-code-pre .tp) { color: hsl(45 90% 65%); }
  .sb-content :global(.sb-code-pre .nb) { color: hsl(207 90% 64%); }
  .sb-content :global(.sb-code-pre .val) { color: hsl(30 90% 60%); }

  .sb-content :global(.sb-tip) {
    margin: 10px 0;
    padding: 8px 12px;
    background: hsl(120 55% 45% / .08);
    border-left: 3px solid hsl(120 55% 45%);
    border-radius: 0 6px 6px 0;
    font-size: 12px;
    color: hsl(215 20% 70%);
  }
</style>

