      <div class="sb-tip">Usa <code>@SpringBootTest</code> + <code>@AutoConfigureMockMvc</code> para tests de integración que cargan el contexto completo. Para tests unitarios, usa <code>@ExtendWith(MockitoExtension.class)</code> sin levantar Spring.</div>
    `,
  };

  /* ── Render ── */
  function render(key) {
    if (sections[key]) {
      content.innerHTML = sections[key]();
      bindCopyButtons();
    }
  }

  /* ── Copy buttons ── */
  function bindCopyButtons() {
    content.querySelectorAll(".sb-copy-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const raw = decodeURIComponent(btn.dataset.code || "");
        const text = raw.replace(/<[^>]+>/g, "");
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = "Copiado!";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copiar";
            btn.classList.remove("copied");
          }, 1500);
        });
      });
    });
  }

  /* ── Sidebar nav ── */
  sidebar.addEventListener("click", (e) => {
    const link = e.target.closest(".sb-link");
    if (!link) return;
    sidebar.querySelectorAll(".sb-link").forEach(l => l.classList.remove("active"));
    link.classList.add("active");
    render(link.dataset.section);
  });

  /* ── Init ── */
  render("getting-started");
})();
</script>
