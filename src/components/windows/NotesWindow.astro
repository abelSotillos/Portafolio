---
// windows/NotesWindow.astro
interface Props {
  placeholder?: string;
}
const { placeholder = "Empieza a escribir..." } = Astro.props;
---

<div class="notes">
  <div class="notes-toolbar">
    <button class="notes-btn" title="Negrita"><b>B</b></button>
    <button class="notes-btn" title="Cursiva"><i>I</i></button>
    <button class="notes-btn" title="Subrayado"><u>U</u></button>
    <div class="notes-divider"></div>
    <span class="notes-info" id="notes-count">0 caracteres</span>
  </div>
  <textarea
    id="notes-textarea"
    class="notes-textarea"
    placeholder={placeholder}
    spellcheck="false"
  ></textarea>
</div>

<style>
  .notes {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .notes-toolbar {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    background: hsl(217 33% 16%);
    border-bottom: 1px solid hsl(217 33% 22% / .6);
    flex-shrink: 0;
  }

  .notes-btn {
    width: 28px; height: 26px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: hsl(215 20% 65%);
    font-size: 13px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .12s, border-color .12s;
  }
  .notes-btn:hover { background: hsl(217 33% 22%); border-color: hsl(217 33% 28% / .5); color: #fff; }

  .notes-divider {
    width: 1px; height: 16px;
    background: hsl(217 33% 25% / .5);
    margin: 0 4px;
  }

  .notes-info {
    font-size: 11px;
    color: hsl(215 20% 38%);
    margin-left: auto;
  }

  .notes-textarea {
    flex: 1;
    padding: 14px 16px;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    color: hsl(215 20% 80%);
    font-size: 14px;
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    line-height: 1.6;
  }
  .notes-textarea::placeholder { color: hsl(215 20% 30%); }
</style>

<script>
  const textarea = document.getElementById('notes-textarea') as HTMLTextAreaElement | null;
  const counter  = document.getElementById('notes-count');

  textarea?.addEventListener('input', () => {
    const len = textarea.value.length;
    if (counter) counter.textContent = `${len} carácter${len !== 1 ? 'es' : ''}`;
  });
</script>
