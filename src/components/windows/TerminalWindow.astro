  function esc(s: string) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  const termRoot = document.getElementById("terminal-root")!;
  const inputLine = termRoot.querySelector(".term-input-line") as HTMLElement;
  let rmLocked = false;

  function sleep(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  async function typeText(target: HTMLElement, text: string, speed = 35) {
    for (const ch of text) {
      target.innerHTML += ch === "\n" ? "<br>" : esc(ch);
      target.scrollTop = target.scrollHeight;
      await sleep(speed);
    }
  }

  async function rmRfSequence() {
    rmLocked = true;
    input.disabled = true;
    inputLine.style.display = "none";

    // 1. Fake "deleting" lines
    const dirs = ["/home/abel/2025", "/home/abel/2024", "/home/abel/2023",
      "/home/abel/2021-2022", "/home/abel/2020-2021", "/home/abel/.secreto",
      "/home/abel", "/home", "/etc", "/usr", "/var", "/"];
    for (const d of dirs) {
      output.innerHTML += `<span class="term-error">rm: eliminando '${d}'...</span>\n`;
      output.scrollTop = output.scrollHeight;
      await sleep(120);
    }

    // 2. Flash
    termRoot.classList.add("rm-flash");
    await sleep(500);
    termRoot.classList.remove("rm-flash");

    // 3. White screen
    output.innerHTML = "";
    termRoot.classList.add("rm-white");
    await sleep(2000);

    // 4. Rebuild — back to dark, type the message
    termRoot.classList.remove("rm-white");
    termRoot.classList.add("rm-rebuild");
    termRoot.style.background = "";
    await sleep(600);

    // 5. Type rebuild lines character by character
    const lines = [
      "Reconstruyendo sistema...",
      "",
      "████████████████████ 100%",
      "",
      "Sistema restaurado.",
      "",
    ];
    for (const line of lines) {
      await typeText(output, line + "\n", 25);
      await sleep(200);
    }
    await sleep(400);

    // 6. Final warning
    const warning = "No vuelvas a hacer eso.";
    const warningEl = document.createElement("span");
    warningEl.className = "term-error";
    warningEl.style.fontSize = "15px";
    warningEl.style.fontWeight = "bold";
    output.appendChild(warningEl);
    await typeText(warningEl, warning, 60);
    output.innerHTML += "\n\n";
    output.scrollTop = output.scrollHeight;

    await sleep(800);

    // 7. Restore terminal
    termRoot.classList.remove("rm-rebuild");
    inputLine.style.display = "";
    input.disabled = false;
    input.focus();
    rmLocked = false;
  }

  function exec(raw: string) {
    const trimmed = raw.trim();
    if (!trimmed || rmLocked) return;

    cmdHistory.unshift(trimmed);
    histIdx = -1;

    const promptHtml = `<span class="term-prompt">${esc(getPrompt())}</span>${esc(trimmed)}`;

    // Check easter eggs first (full command match)
    const eggKey = Object.keys(easterEggs).find(k => trimmed.toLowerCase() === k.toLowerCase());
    if (eggKey) {
      const result = easterEggs[eggKey]();
      if (result === "__RM_RF__") {
        output.innerHTML += `\n${promptHtml}\n`;
        rmRfSequence();
        return;
      }
      output.innerHTML += `\n${promptHtml}\n${result}\n`;
      output.scrollTop = output.scrollHeight;
      return;
    }

    // Check sudo
    if (trimmed.startsWith("sudo ")) {
      sudoCount++;
      const msgs = [
        "abel no está en el archivo sudoers. Se reportará este incidente.",
        "Otra vez intentando sudo... No aprenderás, ¿eh?",
        "¿Sudo? En esta terminal mando yo.",
        `Van ${sudoCount} intentos de sudo. ¿Quieres que te banee?`,
      ];
      const msg = sudoCount <= 3 ? msgs[sudoCount - 1] : msgs[3];
      output.innerHTML += `\n${promptHtml}\n<span class="term-error">${msg}</span>\n`;
      output.scrollTop = output.scrollHeight;
      return;
    }

    const [cmd, ...args] = trimmed.split(/\s+/);
    const handler = builtins[cmd.toLowerCase()];

    if (handler) {
      const result = handler(args);
      if (result === "__CLEAR__") { output.innerHTML = ""; return; }
      if (result) output.innerHTML += `\n${promptHtml}\n${result}\n`;
      else output.innerHTML += `\n${promptHtml}\n`;
    } else {
      output.innerHTML += `\n${promptHtml}\n<span class="term-error">${esc(cmd)}: comando no encontrado.</span> Escribe <span class="term-cmd">help</span> para ver los disponibles.\n`;
    }

    output.scrollTop = output.scrollHeight;
  }

  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      exec(input.value);
      input.value = "";
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (histIdx < cmdHistory.length - 1) { histIdx++; input.value = cmdHistory[histIdx]; }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (histIdx > 0) { histIdx--; input.value = cmdHistory[histIdx]; }
      else { histIdx = -1; input.value = ""; }
    } else if (e.key === "Tab") {
      e.preventDefault();
      // Simple tab completion for files/dirs in cwd
      const val = input.value;
      const parts = val.split(/\s+/);
      const partial = parts[parts.length - 1] || "";
      const node = getNode(cwd);
      if (node?.type === "dir" && partial) {
        const match = Object.keys(node.children).find(k => k.startsWith(partial));
        if (match) {
          parts[parts.length - 1] = match;
          input.value = parts.join(" ");
        }
      }
    } else if (e.key === "l" && e.ctrlKey) {
      e.preventDefault();
      output.innerHTML = "";
    }
  });

  document.getElementById("terminal-root")?.addEventListener("click", () => {
    input.focus();
  });
</script>
