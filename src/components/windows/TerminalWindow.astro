<div class="term" id="terminal-root">
  <div class="term-output" id="term-output">
    <pre class="term-welcome">abel@portfolio:~$ neofetch
<span class="term-accent">       ___       </span>  <span class="term-label">OS:</span> AbelOS v1.0
<span class="term-accent">      /   \      </span>  <span class="term-label">Host:</span> abelsotillos.com
<span class="term-accent">     | ^_^ |     </span>  <span class="term-label">Uptime:</span> +25 años
<span class="term-accent">      \___/      </span>  <span class="term-label">Stack:</span> Angular · Spring Boot · Astro
<span class="term-accent">     /|   |\     </span>  <span class="term-label">IDE:</span> VS Code
<span class="term-accent">    / |   | \    </span>  <span class="term-label">Shell:</span> portfolio-sh
<span class="term-accent">   •  •   •  •   </span>  <span class="term-label">Contacto:</span> abelsotillos@gmail.com

Escribe <span class="term-cmd">help</span> para ver los comandos disponibles.
</pre>
  </div>
  <div class="term-input-line">
    <span class="term-prompt" id="term-prompt">abel@portfolio:~$&nbsp;</span>
    <input
      type="text"
      id="term-input"
      class="term-input"
      spellcheck="false"
      autocomplete="off"
      autofocus
    />
  </div>
</div>

<style>
  .term {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: hsl(222 47% 6%);
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    font-size: 13px;
    color: hsl(215 20% 75%);
  }

  .term-output {
    flex: 1;
    overflow-y: auto;
    padding: 12px 14px 0;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
  }

  .term-welcome {
    margin: 0;
    font: inherit;
    line-height: 1.5;
  }

  .term-accent { color: hsl(142 60% 55%); }
  .term-label { color: hsl(213 90% 65%); }
  .term-cmd { color: hsl(45 90% 65%); }
  .term-error { color: hsl(0 70% 60%); }
  .term-dim { color: hsl(215 20% 40%); }

  .term-input-line {
    display: flex;
    align-items: center;
    padding: 8px 14px 12px;
    flex-shrink: 0;
  }

  .term-prompt {
    color: hsl(142 60% 55%);
    white-space: pre;
    flex-shrink: 0;
  }

  .term-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: hsl(215 20% 85%);
    font: inherit;
    caret-color: hsl(142 60% 55%);
  }

  .term.rm-flash {
    animation: rm-flash .12s linear 4;
  }
  @keyframes rm-flash {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .term.rm-white {
    background: #fff !important;
    transition: background .3s;
  }
  .term.rm-white .term-output,
  .term.rm-white .term-input-line { visibility: hidden; }

  .term.rm-rebuild .term-output,
  .term.rm-rebuild .term-input-line { visibility: visible; }
  .term.rm-rebuild { transition: background .5s; }
</style>

<script>
  import { getNode } from './terminal/filesystem';
  import { createBuiltins, esc, type TerminalState } from './terminal/commands';
  import { easterEggs, sudoHandler } from './terminal/easterEggs';
  import { rmRfSequence } from './terminal/rmSequence';

  // ── DOM refs ──
  const output   = document.getElementById("term-output")!;
  const input    = document.getElementById("term-input") as HTMLInputElement;
  const promptEl = document.getElementById("term-prompt")!;
  const termRoot = document.getElementById("terminal-root")!;
  const inputLine = termRoot.querySelector(".term-input-line") as HTMLElement;

  // ── Mutable state ──
  const cmdHistory: string[] = [];
  let histIdx = -1;
  let rmLocked = false;

  const state: TerminalState = {
    cwd: "/home/abel",
    setCwd(path: string) { state.cwd = path; },
    updatePrompt,
    cmdHistory,
    sessionStart: Date.now(),
  };

  function getPrompt(): string {
    const display = state.cwd === "/home/abel" ? "~" : state.cwd.replace("/home/abel", "~");
    return `abel@portfolio:${display}$\u00a0`;
  }

  function updatePrompt() {
    promptEl.textContent = getPrompt();
  }

  // ── Build commands ──
  const builtins = createBuiltins(state);

  // ── Exec ──
  function exec(raw: string) {
    const trimmed = raw.trim();
    if (!trimmed || rmLocked) return;

    cmdHistory.unshift(trimmed);
    histIdx = -1;

    const promptHtml = `<span class="term-prompt">${esc(getPrompt())}</span>${esc(trimmed)}`;

    // Easter eggs (full command match)
    const eggKey = Object.keys(easterEggs).find(k => trimmed.toLowerCase() === k.toLowerCase());
    if (eggKey) {
      const result = easterEggs[eggKey]();
      if (result === "__RM_RF__") {
        output.innerHTML += `\n${promptHtml}\n`;
        rmRfSequence(
          { termRoot, output, inputLine, input },
          (v) => { rmLocked = v; }
        );
        return;
      }
      output.innerHTML += `\n${promptHtml}\n${result}\n`;
      output.scrollTop = output.scrollHeight;
      return;
    }

    // Sudo
    const sudoResult = sudoHandler(trimmed);
    if (sudoResult) {
      output.innerHTML += `\n${promptHtml}\n${sudoResult}\n`;
      output.scrollTop = output.scrollHeight;
      return;
    }

    // Builtins
    const [cmd, ...args] = trimmed.split(/\s+/);
    const handler = builtins[cmd.toLowerCase()];

    if (handler) {
      const result = handler(args);
      if (result === "__CLEAR__") { output.innerHTML = ""; return; }
      if (result) output.innerHTML += `\n${promptHtml}\n${result}\n`;
      else output.innerHTML += `\n${promptHtml}\n`;
    } else {
      output.innerHTML += `\n${promptHtml}\n<span class="term-error">${esc(cmd)}: comando no encontrado.</span> Escribe <span class="term-cmd">help</span> para ver los disponibles.\n`;
    }

    output.scrollTop = output.scrollHeight;
  }

  // ── Keyboard ──
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      exec(input.value);
      input.value = "";
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (histIdx < cmdHistory.length - 1) { histIdx++; input.value = cmdHistory[histIdx]; }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (histIdx > 0) { histIdx--; input.value = cmdHistory[histIdx]; }
      else { histIdx = -1; input.value = ""; }
    } else if (e.key === "Tab") {
      e.preventDefault();
      const val = input.value;
      const parts = val.split(/\s+/);
      const partial = parts[parts.length - 1] || "";
      // Tab-complete commands if first token
      if (parts.length <= 1 && partial) {
        const match = Object.keys(builtins).find(k => k.startsWith(partial));
        if (match) { input.value = match + " "; return; }
      }
      // Tab-complete files/dirs
      const node = getNode(state.cwd === "/home/abel" ? "/home/abel" : state.cwd);
      if (node?.type === "dir" && partial) {
        const match = Object.keys(node.children).find(k => k.startsWith(partial));
        if (match) {
          parts[parts.length - 1] = match;
          input.value = parts.join(" ");
        }
      }
    } else if (e.key === "l" && e.ctrlKey) {
      e.preventDefault();
      output.innerHTML = "";
    }
  });

  termRoot.addEventListener("click", () => { input.focus(); });
</script>
