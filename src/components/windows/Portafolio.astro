<style>
  /* ── BASE ── */
  .cv {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: "Segoe UI", system-ui, sans-serif;
    background: hsl(217 33% 11%);
    color: hsl(215 20% 80%);
    overflow: hidden;
  }

  /* ── HEADER ── */
  .cv-header {
    flex-shrink: 0;
    padding: 16px 18px 10px;
    background: hsl(217 33% 14%);
    border-bottom: 1px solid hsl(217 33% 22% / .6);
  }

  .cv-header-inner {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .cv-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid hsl(217 91% 60% / .5);
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 0 14px hsl(217 91% 60% / .2);
  }

  .cv-identity {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cv-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: hsl(210 40% 98%);
    text-shadow: 0 0 18px hsl(217 91% 60% / .55);
    line-height: 1.2;
  }

  .cv-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cv-role {
    color: hsl(217 91% 60%);
    font-size: 0.8rem;
  }

  .cv-badge {
    padding: 2px 8px;
    border-radius: 10px;
    background: hsl(217 91% 30% / .3);
    border: 1px solid hsl(217 91% 60% / .35);
    color: hsl(217 91% 70%);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .cv-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .cv-contact-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    color: hsl(215 20% 52%);
    text-decoration: none;
    transition: color .15s;
  }
  .cv-contact-item:hover { color: hsl(217 91% 65%); }
  .cv-contact-item svg { flex-shrink: 0; color: hsl(217 91% 55%); }

  /* ── TABS BAR ── */
  .cv-tabs-bar {
    display: flex;
    gap: 2px;
    padding: 6px 12px 0;
    background: hsl(217 33% 14%);
    border-bottom: 1px solid hsl(217 33% 22% / .5);
    flex-shrink: 0;
  }

  .cv-tab {
    padding: 6px 14px;
    background: transparent;
    border: none;
    border-radius: 6px 6px 0 0;
    color: hsl(215 20% 50%);
    font-size: 0.78rem;
    font-family: inherit;
    cursor: pointer;
    transition: background .15s, color .15s;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .cv-tab:hover { background: hsl(217 33% 20%); color: hsl(215 20% 75%); }
  .cv-tab.active {
    color: hsl(217 91% 70%);
    border-bottom-color: hsl(217 91% 60%);
    background: hsl(217 33% 17%);
  }

  /* ── BODY / PANELS ── */
  .cv-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px 18px;
    scrollbar-width: thin;
    scrollbar-color: hsl(217 33% 28%) transparent;
  }
  .cv-body::-webkit-scrollbar { width: 5px; }
  .cv-body::-webkit-scrollbar-track { background: transparent; }
  .cv-body::-webkit-scrollbar-thumb { background: hsl(217 33% 28%); border-radius: 3px; }

  .cv-panel { display: none; }
  .cv-panel.active { display: block; }

  /* ── SECTIONS ── */
  .cv-section { margin-bottom: 22px; }
  .cv-section:last-child { margin-bottom: 0; }

  .cv-section-title {
    margin: 0 0 10px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: hsl(217 91% 60%);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cv-section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: hsl(217 33% 25% / .7);
  }

  /* ── PERFIL ── */
  .cv-summary {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: hsl(215 20% 68%);
  }
  .cv-summary strong { color: hsl(215 20% 85%); }

  /* ── LANGUAGES ── */
  .lang-list { display: flex; flex-direction: column; gap: 10px; }

  .lang-item { display: flex; flex-direction: column; gap: 5px; }

  .lang-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .lang-name { font-size: 0.82rem; color: hsl(215 20% 78%); }
  .lang-level { font-size: 0.7rem; color: hsl(215 20% 45%); }

  .lang-bar-bg {
    height: 5px;
    border-radius: 3px;
    background: hsl(217 33% 22%);
    overflow: hidden;
  }
  .lang-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, hsl(217 91% 50%), hsl(200 80% 60%));
  }

  /* ── EXPERIENCIA ── */
  .company-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 8px 12px;
    background: hsl(217 33% 16%);
    border-radius: 8px;
    border: 1px solid hsl(217 33% 24% / .5);
  }

  .company-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: hsl(217 33% 35%);
    flex-shrink: 0;
  }
  .company-dot.active-dot {
    background: hsl(142 70% 50%);
    box-shadow: 0 0 6px hsl(142 70% 50% / .6);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 5px hsl(142 70% 50% / .5); }
    50%       { box-shadow: 0 0 12px hsl(142 70% 50% / .9); }
  }

  .company-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: hsl(215 20% 82%);
    letter-spacing: .03em;
  }

  .company-period {
    margin-left: auto;
    font-size: 0.7rem;
    color: hsl(215 20% 42%);
  }

  /* ── TIMELINE ── */
  .timeline {
    position: relative;
    padding-left: 22px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: hsl(217 33% 26%);
  }

  .tl-item {
    position: relative;
    padding-bottom: 20px;
  }
  .tl-item--last { padding-bottom: 0; }

  .tl-dot {
    position: absolute;
    left: -18px;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: hsl(217 33% 30%);
    border: 1.5px solid hsl(217 33% 40%);
  }

  .tl-dot--current {
    background: hsl(142 70% 45%);
    border-color: hsl(142 70% 60%);
    animation: pulse-dot 2s infinite;
  }

  .tl-content {
    background: hsl(217 33% 15%);
    border: 1px solid hsl(217 33% 22% / .6);
    border-radius: 8px;
    padding: 10px 12px;
    transition: border-color .15s;
  }
  .tl-content:hover { border-color: hsl(217 33% 32%); }

  .tl-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 3px;
  }

  .tl-project {
    font-size: 0.82rem;
    font-weight: 600;
    color: hsl(215 20% 86%);
    line-height: 1.3;
  }

  .tl-period {
    font-size: 0.68rem;
    color: hsl(215 20% 40%);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .current-badge {
    color: hsl(142 60% 50%);
    background: hsl(142 60% 20% / .25);
    padding: 1px 6px;
    border-radius: 8px;
    border: 1px solid hsl(142 60% 40% / .3);
  }

  .tl-role {
    font-size: 0.7rem;
    color: hsl(217 91% 60%);
    display: block;
    margin-bottom: 5px;
  }

  .tl-desc {
    margin: 0 0 8px;
    font-size: 0.75rem;
    line-height: 1.55;
    color: hsl(215 20% 55%);
  }

  .tl-stack { display: flex; flex-wrap: wrap; gap: 4px; }

  /* ── CHIPS (timeline) ── */
  .tl-chip {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.68rem;
    font-weight: 500;
