    keycloak: [{ key: "port", label: "Puerto", default: "8080" }],
    mailhog: [{ key: "smtp", label: "Puerto SMTP", default: "1025" }, { key: "web", label: "Puerto Web", default: "8025" }],
    n8n: [{ key: "port", label: "Puerto", default: "5678" }],
    wireguard: [{ key: "port", label: "Puerto UDP", default: "51820" }],
    pihole: [{ key: "web", label: "Puerto Web", default: "8053" }],
    homeassistant: [{ key: "port", label: "Puerto", default: "8123" }],
    custom: [{ key: "name", label: "Nombre servicio", default: "mi-app" }, { key: "image", label: "Imagen", default: "nginx:alpine" }, { key: "port", label: "Puerto (host:container)", default: "8080:80" }],
  };

  function updateExtraFields(type: string) {
    const fields = fieldDefs[type] || [];
    extraFields.innerHTML = fields.map(f =>
      `<label class="dk-label">${f.label}
        <input class="dk-input" data-key="${f.key}" value="${f.default}" placeholder="${f.default}">
      </label>`
    ).join("");
  }

  document.getElementById("dk-svc-add-btn")!.addEventListener("click", () => {
    const type = svcType.value;
    if (!type) return;
    const vals: Record<string, string> = {};
    extraFields.querySelectorAll<HTMLInputElement>(".dk-input").forEach(inp => {
      vals[inp.dataset.key!] = inp.value || inp.placeholder;
    });

    const generators: Record<string, () => SvcDef[]> = {
      wordpress: () => [
        { name: "wordpress", yaml:
`  wordpress:
    image: wordpress:latest
    ports:
      - "${vals.port}:80"
