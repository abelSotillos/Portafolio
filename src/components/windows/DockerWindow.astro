      - "${vals.port}:9090"
    volumes:
      - prometheus-data:/prometheus
    restart: always
    networks:
      - app-net` }],
      uptime: () => [{ name: "uptime-kuma", yaml:
`  uptime-kuma:
    image: louislam/uptime-kuma:latest
    ports:
      - "${vals.port}:3001"
    volumes:
      - uptime-data:/app/data
    restart: always
    networks:
      - app-net` }],
      plausible: () => [{ name: "plausible", yaml:
`  plausible:
    image: ghcr.io/plausible/community-edition:latest
    ports:
      - "${vals.port}:8000"
