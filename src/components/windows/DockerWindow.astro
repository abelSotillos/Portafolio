      PASSWORD: ${vals.dbpass}
    volumes:
      - odoo-data:/var/lib/odoo
    networks:
      - app-net
    depends_on:
      - odoo-db` },
        { name: "odoo-db", yaml:
`  odoo-db:
    image: postgres:15
    environment:
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: ${vals.dbpass}
      POSTGRES_DB: postgres
    volumes:
      - odoo-db-data:/var/lib/postgresql/data
    networks:
      - app-net` },
      ],
      nginx: () => [{ name: "nginx", yaml:
`  nginx:
    image: nginx:alpine
    ports:
      - "${vals.port}:80"
    networks:
      - app-net` }],
      mysql: () => [{ name: "mysql", yaml:
`  mysql:
    image: mysql:8
    ports:
      - "${vals.port}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${vals.rootpass}
      MYSQL_DATABASE: ${vals.db}
    volumes:
      - mysql-data:/var/lib/mysql
    networks:
      - app-net` }],
      postgres: () => [{ name: "postgres", yaml:
`  postgres:
    image: postgres:16
    ports:
      - "${vals.port}:5432"
    environment:
      POSTGRES_USER: ${vals.user}
      POSTGRES_PASSWORD: ${vals.pass}
      POSTGRES_DB: ${vals.db}
    volumes:
      - pg-data:/var/lib/postgresql/data
    networks:
      - app-net` }],
      redis: () => [{ name: "redis", yaml:
`  redis:
    image: redis:alpine
    ports:
      - "${vals.port}:6379"
    volumes:
      - redis-data:/data
    networks:
      - app-net` }],
      mongo: () => [{ name: "mongo", yaml:
`  mongo:
    image: mongo:7
    ports:
      - "${vals.port}:27017"
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${vals.user}
      MONGO_INITDB_ROOT_PASSWORD: ${vals.pass}
