  function renderYaml() {
    if (services.length === 0) {
      yamlPre.textContent = 'version: "3.9"\nservices:\n  # Añade un servicio para empezar';
      return;
    }
    let yaml = 'version: "3.9"\nservices:\n';
    const volumes = new Set<string>();
    const networks = new Set<string>();
    for (const svc of services) {
      yaml += svc.yaml + "\n";
      // extract volume names
      const volMatches = svc.yaml.matchAll(/^\s+- ([a-z0-9_-]+):/gm);
      for (const m of volMatches) {
        if (!m[1].startsWith("/") && !m[1].startsWith(".")) volumes.add(m[1]);
      }
    }
    if (services.length > 0) {
      networks.add("app-net");
      yaml += "\nnetworks:\n  app-net:\n    driver: bridge\n";
    }
    if (volumes.size > 0) {
      yaml += "\nvolumes:\n";
      for (const v of volumes) yaml += `  ${v}:\n`;
    }
    yamlPre.textContent = yaml;
  }

  function renderSvcList() {
    svcList.innerHTML = services.map((s, i) =>
