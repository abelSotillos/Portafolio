  function renderCards(filter: string = "") {
    const q = filter.toLowerCase();
    const filtered = q ? quickApps.filter(a => a.id.includes(q) || a.name.toLowerCase().includes(q) || a.desc.toLowerCase().includes(q)) : quickApps;
    quickGrid.innerHTML = filtered.length
      ? filtered.map(app =>
          `<div class="dk-quick-card" data-app="${app.id}">
            <span class="dk-card-icon">${app.icon}</span>
            <span class="dk-card-name">${app.name}</span>
          </div>`
        ).join("")
      : `<div class="dk-no-results">Sin resultados para "${filter}"</div>`;
  }
  renderCards();

  quickFilter.addEventListener("input", () => renderCards(quickFilter.value));

  // Tooltip
  const tooltip = document.getElementById("dk-tooltip")!;
  const quickPanel = document.getElementById("dk-quick")!;

  quickGrid.addEventListener("mouseenter", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>(".dk-quick-card");
    if (!card) return;
    const app = quickApps.find(a => a.id === card.dataset.app);
    if (!app) return;

    tooltip.textContent = app.desc;
    tooltip.classList.remove("hidden", "above", "below");

    const panelRect = quickPanel.getBoundingClientRect();
    const cardRect = card.getBoundingClientRect();

    // Position horizontally centered on the card
    let left = cardRect.left - panelRect.left + cardRect.width / 2 - tooltip.offsetWidth / 2;
    // Clamp to panel edges
    left = Math.max(6, Math.min(left, panelRect.width - tooltip.offsetWidth - 6));

    // Prefer below, but if not enough room show above
    const spaceBelow = panelRect.bottom - cardRect.bottom;
    if (spaceBelow > tooltip.offsetHeight + 12) {
      tooltip.style.top = (cardRect.bottom - panelRect.top + 6) + "px";
      tooltip.classList.add("below");
    } else {
      tooltip.style.top = (cardRect.top - panelRect.top - tooltip.offsetHeight - 6) + "px";
      tooltip.classList.add("above");
    }
    tooltip.style.left = left + "px";
  }, true);

  quickGrid.addEventListener("mouseleave", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>(".dk-quick-card");
    if (!card) return;
    tooltip.classList.add("hidden");
  }, true);

  let currentApp: QuickApp | null = null;

  quickGrid.addEventListener("click", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>(".dk-quick-card");
    if (!card) return;
    const app = quickApps.find(a => a.id === card.dataset.app);
    if (!app) return;
    currentApp = app;
    quickTitle.innerHTML = `${app.name}`;
    quickFields.innerHTML = app.fields.map(f =>
      `<label class="dk-label">${f.label}
        <input class="dk-input" data-key="${f.key}" value="${f.default}" placeholder="${f.placeholder}">
      </label>`
