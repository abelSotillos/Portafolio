        </div>
        <div id="dk-svc-extra-fields"></div>
        <div class="dk-modal-actions">
          <button class="dk-btn-cancel" id="dk-svc-cancel">Cancelar</button>
          <button class="dk-generate-btn" id="dk-svc-add-btn">Añadir</button>
        </div>
