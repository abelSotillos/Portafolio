<!-- SCRIPT                                          -->
<!-- ═══════════════════════════════════════════════ -->
<script>
  // ── Tab switching ──
  const root = document.getElementById("docker-root")!;
  const tabs = root.querySelectorAll<HTMLButtonElement>(".dk-tab");
  const panels = root.querySelectorAll<HTMLElement>(".dk-panel");

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      tabs.forEach(t => t.classList.remove("active"));
      panels.forEach(p => p.classList.remove("active"));
      tab.classList.add("active");
      root.querySelector(`#dk-${tab.dataset.tab}`)?.classList.add("active");
    });
  });

  // ════════════════════════════════════════════════
  // TAB 1: DOCS
  // ════════════════════════════════════════════════
  const copyIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
  const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

  function cmd(command: string, output?: string): string {
    const plain = command.replace(/<[^>]*>/g, "");
    return `<div class="dk-cmd-block"><div class="dk-cmd-header"><code><span class="dk-ps1">$</span> ${command}</code><button class="dk-cmd-copy" data-cmd="${plain.replace(/"/g, "&quot;")}" title="Copiar">${copyIcon}</button></div>${output ? `<pre class="dk-cmd-out">${output}</pre>` : ""}</div>`;
  }
