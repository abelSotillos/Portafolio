    volumes:
      - wp-data:/var/www/html
    networks:
      - app-net
    depends_on:
      - wordpress-db` },
        { name: "wordpress-db", yaml:
`  wordpress-db:
    image: mysql:8
    environment:
      MYSQL_ROOT_PASSWORD: ${vals.dbpass}
