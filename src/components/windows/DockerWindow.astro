  function renderSvcDropdown(filter: string = "") {
    const q = filter.toLowerCase();
    const filtered = q ? svcOptions.filter(o => o.label.toLowerCase().includes(q) || o.value.includes(q)) : svcOptions;
    if (!filtered.length) {
      svcDropdown.innerHTML = `<div class="dk-select-empty">Sin resultados</div>`;
      return;
    }
    // Group by type, preserving order
    const groups = new Map<string, typeof filtered>();
    for (const opt of filtered) {
      const key = opt.group || "";
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(opt);
    }
    let html = "";
    for (const [group, opts] of groups) {
      if (group) html += `<div class="dk-select-group">${group}</div>`;
      for (const opt of opts) {
        html += `<div class="dk-select-option" data-value="${opt.value}">${opt.label}</div>`;
      }
    }
    svcDropdown.innerHTML = html;
  }

  function selectSvcType(value: string) {
    svcType.value = value;
    const opt = svcOptions.find(o => o.value === value);
    svcSearch.value = opt ? opt.label : "";
    svcDropdown.classList.add("hidden");
    // Trigger field update
    updateExtraFields(value);
  }

