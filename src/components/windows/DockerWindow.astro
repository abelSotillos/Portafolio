      - minio-data:/data
    networks:
      - app-net` }],
      vault: () => [{ name: "vault", yaml:
`  vault:
    image: hashicorp/vault:latest
    ports:
      - "${vals.port}:8200"
    environment:
      VAULT_DEV_ROOT_TOKEN_ID: myroot
      VAULT_DEV_LISTEN_ADDRESS: 0.0.0.0:8200
    cap_add:
      - IPC_LOCK
    networks:
      - app-net` }],
      keycloak: () => [{ name: "keycloak", yaml:
`  keycloak:
    image: quay.io/keycloak/keycloak:latest
    command: start-dev
    ports:
      - "${vals.port}:8080"
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
    networks:
      - app-net` }],
      mailhog: () => [{ name: "mailhog", yaml:
`  mailhog:
    image: mailhog/mailhog:latest
    ports:
      - "${vals.smtp}:1025"
      - "${vals.web}:8025"
    networks:
      - app-net` }],
      n8n: () => [{ name: "n8n", yaml:
`  n8n:
    image: n8nio/n8n:latest
    ports:
      - "${vals.port}:5678"
    volumes:
      - n8n-data:/home/node/.n8n
    restart: always
    networks:
      - app-net` }],
      wireguard: () => [{ name: "wireguard", yaml:
`  wireguard:
    image: lscr.io/linuxserver/wireguard:latest
    ports:
      - "${vals.port}:51820/udp"
    environment:
      PUID: "1000"
      PGID: "1000"
    volumes:
      - wireguard-config:/config
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    restart: always
    networks:
      - app-net` }],
      pihole: () => [{ name: "pihole", yaml:
`  pihole:
    image: pihole/pihole:latest
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "${vals.web}:80"
    environment:
      WEBPASSWORD: admin
    volumes:
      - pihole-etc:/etc/pihole
      - pihole-dnsmasq:/etc/dnsmasq.d
    restart: always
    networks:
      - app-net` }],
      homeassistant: () => [{ name: "homeassistant", yaml:
`  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:stable
    ports:
      - "${vals.port}:8123"
    environment:
      TZ: Europe/Madrid
    volumes:
      - ha-config:/config
    restart: always
    networks:
      - app-net` }],
      custom: () => {
        const name = vals.name.replace(/\s+/g, "-").toLowerCase();
        const ports = vals.port.includes(":") ? vals.port : `${vals.port}:${vals.port}`;
        return [{ name, yaml:
`  ${name}:
    image: ${vals.image}
    ports:
      - "${ports}"
    networks:
      - app-net` }];
      },
    };

    const gen = generators[type];
    if (!gen) return;
    const newSvcs = gen();

    // Avoid duplicate service names
    for (const s of newSvcs) {
      if (!services.some(x => x.name === s.name)) {
        services.push(s);
      }
    }

    renderSvcList();
    renderYaml();
    modal.classList.add("hidden");
  });

  document.getElementById("dk-compose-copy")!.addEventListener("click", () => {
    navigator.clipboard.writeText(yamlPre.textContent || "");
    const btn = document.getElementById("dk-compose-copy")!;
    btn.textContent = "¡Copiado!";
    setTimeout(() => btn.textContent = "Copiar", 1500);
  });
</script>
