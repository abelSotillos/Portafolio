        <pre id="dk-quick-output"></pre>
        <button class="dk-copy" id="dk-quick-copy">Copiar</button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════ -->
  <!-- TAB 3: COMPOSE GENERATOR                      -->
