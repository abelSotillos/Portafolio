  sidebar.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest<HTMLButtonElement>(".dk-doc-link");
    if (!link) return;
    sidebar.querySelectorAll(".dk-doc-link").forEach(l => l.classList.remove("active"));
    link.classList.add("active");
    docsContent.innerHTML = docs[link.dataset.doc!] || "";
  });

  // Copy command to clipboard
  docsContent.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".dk-cmd-copy");
    if (!btn) return;
    const text = btn.dataset.cmd || "";
    navigator.clipboard.writeText(text).then(() => {
      btn.innerHTML = checkIcon;
      btn.classList.add("copied");
      setTimeout(() => { btn.innerHTML = copyIcon; btn.classList.remove("copied"); }, 1500);
    });
  });

