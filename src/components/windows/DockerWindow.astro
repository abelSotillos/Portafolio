        </div>
        <div class="dk-svc-list" id="dk-svc-list"></div>
      </div>
      <div class="dk-compose-editor">
        <div class="dk-compose-header">
          <span>docker-compose.yml</span>
          <button class="dk-copy" id="dk-compose-copy">Copiar</button>
        </div>
        <pre class="dk-yaml" id="dk-yaml">version: "3.9"
services:
  # Añade un servicio para empezar</pre>
      </div>
    </div>

    <!-- Modal para añadir servicio -->
    <div class="dk-modal hidden" id="dk-svc-modal">
      <div class="dk-modal-box">
        <h3>Añadir servicio</h3>
