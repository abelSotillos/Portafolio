      - "${vals.port}:80"
    environment:
      PMA_ARBITRARY: 1
    networks:
      - app-net` }],
      portainer: () => [{ name: "portainer", yaml:
`  portainer:
    image: portainer/portainer-ce:latest
    ports:
      - "${vals.port}:9443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer-data:/data
