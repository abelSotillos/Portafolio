<style>
  .ng {
    display: flex;
    flex-direction: row;
    height: 100%;
    font-family: "Segoe UI", system-ui, sans-serif;
    background: hsl(222 47% 11%);
    color: hsl(215 20% 80%);
    font-size: 13px;
  }
  .ng :global(*) {
    scrollbar-width: thin;
    scrollbar-color: hsl(217 33% 25%) transparent;
  }
  .ng :global(*::-webkit-scrollbar) { width: 6px; height: 6px; }
  .ng :global(*::-webkit-scrollbar-track) { background: transparent; }
  .ng :global(*::-webkit-scrollbar-thumb) {
    background: hsl(217 33% 25%);
    border-radius: 3px;
  }
  .ng :global(*::-webkit-scrollbar-thumb:hover) {
    background: hsl(217 33% 35%);
  }

  /* ── Sidebar ── */
  .ng-sidebar {
    width: 130px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 6px;
    background: hsl(217 33% 12%);
    border-right: 1px solid hsl(217 33% 22% / .4);
    overflow-y: auto;
  }
  .ng-link {
    padding: 6px 10px;
    background: transparent;
    border: none;
    border-radius: 5px;
    color: hsl(215 20% 55%);
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .ng-link:hover { background: hsl(217 33% 18%); color: hsl(215 20% 75%); }
  .ng-link.active { background: hsl(0 70% 50% / .15); color: hsl(0 80% 65%); }

  /* ── Top bar + toggle (mobile only) ── */
  .ng-topbar {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
    height: 40px;
    flex-shrink: 0;
    background: hsl(217 33% 12%);
    border-bottom: 1px solid hsl(217 33% 22% / .4);
    z-index: 12;
  }
  .ng-topbar-title {
    font-size: 13px;
    font-weight: 600;
    color: hsl(0 80% 65%);
  }
  .ng-sidebar-toggle {
    display: flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: hsl(215 20% 70%);
    cursor: pointer;
    border-radius: 6px;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .ng-sidebar-toggle:active { background: hsl(217 33% 20%); }
  .ng-sidebar-overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.4);
    z-index: 10;
  }

  @media (max-width: 768px) {
    .ng { flex-direction: column; position: relative; }
    .ng-topbar { display: flex; position: relative; z-index: 15; }
    .ng-sidebar {
      position: absolute;
      top: 40px;
      left: 0;
      bottom: 0;
      z-index: 14;
      width: 170px;
      transform: translateX(-100%);
      transition: transform .2s ease;
      box-shadow: none;
      background: hsl(217 33% 10%);
      padding: 10px 8px;
      gap: 4px;
    }
    .ng-sidebar.open {
      transform: translateX(0);
      box-shadow: 4px 0 20px rgba(0,0,0,.5);
    }
    .ng-link {
      font-size: 14px;
      padding: 10px 12px;
    }
    .ng-sidebar-overlay {
      position: absolute;
      top: 40px;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 13;
    }
    .ng-sidebar-overlay.open {
      display: block;
    }
  }

  /* ── Content ── */
  .ng-content {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
    line-height: 1.6;
  }
  .ng-content :global(h2) {
    color: hsl(0 80% 65%);
    font-size: 16px;
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ng-content :global(h3) {
    color: hsl(355 80% 62%);
    font-size: 13px;
    margin: 16px 0 6px;
  }
  .ng-content :global(h3:first-child) { margin-top: 0; }
  .ng-content :global(p) {
    margin: 4px 0;
    font-size: 12px;
    color: hsl(215 20% 60%);
    line-height: 1.5;
  }
  .ng-content :global(code) {
    background: hsl(217 33% 18%);
    padding: 1px 5px;
    border-radius: 3px;
    font-family: "Cascadia Code", "Fira Code", monospace;
    font-size: 11px;
    color: hsl(215 20% 80%);
  }
  .ng-content :global(.ng-code-block) {
    background: hsl(0 0% 3%);
    border: 1px solid hsl(0 0% 14%);
    border-radius: 6px;
    margin: 8px 0;
    overflow: hidden;
    position: relative;
  }
  .ng-content :global(.ng-code-label) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 12px;
    background: hsl(0 0% 7%);
    border-bottom: 1px solid hsl(0 0% 12%);
    font-size: 10px;
    color: hsl(215 20% 40%);
    font-family: "Cascadia Code", "Fira Code", monospace;
  }
  .ng-content :global(.ng-copy-btn) {
    background: none;
    border: none;
    color: hsl(215 20% 35%);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 10px;
    transition: color .15s, background .15s;
  }
  .ng-content :global(.ng-copy-btn:hover) {
    color: hsl(355 80% 62%);
    background: hsl(217 33% 18%);
  }
  .ng-content :global(.ng-copy-btn.copied) { color: hsl(142 60% 55%); }
  .ng-content :global(.ng-code-pre) {
    padding: 10px 12px;
    font-family: "Cascadia Code", "Fira Code", monospace;
    font-size: 11.5px;
    line-height: 1.5;
    color: hsl(215 20% 80%);
    overflow-x: auto;
    white-space: pre;
    margin: 0;
  }
  .ng-content :global(.ng-code-pre .kw) { color: hsl(280 60% 70%); }
  .ng-content :global(.ng-code-pre .dec) { color: hsl(0 80% 65%); }
  .ng-content :global(.ng-code-pre .str) { color: hsl(142 60% 60%); }
  .ng-content :global(.ng-code-pre .fn) { color: hsl(355 80% 68%); }
  .ng-content :global(.ng-code-pre .cm) { color: hsl(215 20% 40%); font-style: italic; }
  .ng-content :global(.ng-code-pre .tp) { color: hsl(45 90% 65%); }
  .ng-content :global(.ng-code-pre .tag) { color: hsl(0 80% 65%); }
  .ng-content :global(.ng-code-pre .attr) { color: hsl(355 80% 68%); }
  .ng-content :global(.ng-code-pre .val) { color: hsl(142 60% 60%); }

  .ng-content :global(.ng-tip) {
    margin: 10px 0;
    padding: 8px 12px;
    background: hsl(355 80% 50% / .08);
    border-left: 3px solid hsl(355 80% 50%);
    border-radius: 0 6px 6px 0;
    font-size: 12px;
    color: hsl(215 20% 70%);
  }
</style>

