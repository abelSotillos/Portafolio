      ${codeBlock("registro.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span>, <span class="tp">inject</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;
<span class="kw">import</span> {
  <span class="tp">ReactiveFormsModule</span>,
  <span class="tp">FormBuilder</span>,
  <span class="tp">Validators</span>
} <span class="kw">from</span> <span class="str">'@angular/forms'</span>;

<span class="dec">@Component</span>({
  <span class="fn">selector</span>: <span class="str">'app-registro'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>,
  <span class="fn">imports</span>: [<span class="tp">ReactiveFormsModule</span>],
  <span class="fn">template</span>: <span class="str">\`
    &lt;form [formGroup]="form" (ngSubmit)="onSubmit()"&gt;
      &lt;label&gt;
        Nombre
        &lt;input formControlName="nombre"&gt;
      &lt;/label&gt;

      @if (form.get('nombre')?.errors?.['required']
           && form.get('nombre')?.touched) {
        &lt;span class="error"&gt;Obligatorio&lt;/span&gt;
      }

      &lt;label&gt;
        Email
        &lt;input formControlName="email" type="email"&gt;
      &lt;/label&gt;

      &lt;button type="submit"
              [disabled]="form.invalid"&gt;
        Registrarse
      &lt;/button&gt;
