      <h3>Pipe personalizado</h3>
      ${codeBlock("truncate.pipe.ts",
`<span class="kw">import</span> { <span class="tp">Pipe</span>, <span class="tp">PipeTransform</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Pipe</span>({
  <span class="fn">name</span>: <span class="str">'truncate'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>
})
<span class="kw">export class</span> <span class="tp">TruncatePipe</span> <span class="kw">implements</span> <span class="tp">PipeTransform</span> {
  <span class="fn">transform</span>(
    value: <span class="tp">string</span>,
    limit = <span class="str">50</span>,
    trail = <span class="str">'...'</span>
  ): <span class="tp">string</span> {
    <span class="kw">return</span> value.length > limit
      ? value.<span class="fn">substring</span>(<span class="str">0</span>, limit) + trail
      : value;
  }
}`)}

      ${codeBlock("uso.html",
`<span class="cm">&lt;!-- Trunca a 30 caracteres --&gt;</span>
<span class="tag">&lt;p&gt;</span>{{ descripcion | <span class="fn">truncate</span>:<span class="str">30</span> }}<span class="tag">&lt;/p&gt;</span>

<span class="cm">&lt;!-- Trunca a 20 con sufijo personalizado --&gt;</span>
<span class="tag">&lt;p&gt;</span>{{ descripcion | <span class="fn">truncate</span>:<span class="str">20</span>:<span class="str">' [+]'</span> }}<span class="tag">&lt;/p&gt;</span>`)}
    `,
  };

  /* ── Render ── */
  function render(key) {
    if (sections[key]) {
      content.innerHTML = sections[key]();
      bindCopyButtons();
    }
  }

  /* ── Copy buttons ── */
  function bindCopyButtons() {
    content.querySelectorAll(".ng-copy-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const raw = decodeURIComponent(btn.dataset.code || "");
        const text = raw.replace(/<[^>]+>/g, "");
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = "Copiado!";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copiar";
            btn.classList.remove("copied");
          }, 1500);
        });
      });
    });
  }

  /* ── Sidebar nav ── */
  const topbarTitle = root.querySelector("#ng-topbar-title");

  sidebar.addEventListener("click", (e) => {
    const link = e.target.closest(".ng-link");
    if (!link) return;
    sidebar.querySelectorAll(".ng-link").forEach(l => l.classList.remove("active"));
    link.classList.add("active");
    render(link.dataset.section);
    if (topbarTitle) topbarTitle.textContent = link.textContent;
    sidebar.classList.remove("open");
    sidebarOverlay.classList.remove("open");
  });

  /* ── Sidebar toggle (mobile) ── */
  const sidebarToggle = root.querySelector("#ng-sidebar-toggle");
  const sidebarOverlay = root.querySelector("#ng-sidebar-overlay")!;

  sidebarToggle?.addEventListener("click", () => {
    sidebar.classList.toggle("open");
    sidebarOverlay.classList.toggle("open");
  });
  sidebarOverlay.addEventListener("click", () => {
    sidebar.classList.remove("open");
    sidebarOverlay.classList.remove("open");
  });

  /* ── Init ── */
  render("getting-started");
})();
</script>
