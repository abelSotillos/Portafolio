<script>
(function () {
  const root = document.getElementById("angular-root");
  if (!root) return;

  const sidebar = root.querySelector("#ng-sidebar");
  const content = root.querySelector("#ng-content");
  if (!sidebar || !content) return;

  /* ── Helper: code block with copy button ── */
  function codeBlock(lang, code) {
    return `<div class="ng-code-block">
      <div class="ng-code-label"><span>${lang}</span><button class="ng-copy-btn" data-code="${encodeURIComponent(code)}">Copiar</button></div>
      <pre class="ng-code-pre">${code}</pre>
    </div>`;
  }

  /* ── Sections ── */
  const sections = {
    "getting-started": () => `
      <h2>Primeros pasos</h2>
      <p>Angular es un framework de desarrollo web creado por Google para construir aplicaciones SPA (Single Page Application).</p>

      <h3>Instalar Angular CLI</h3>
      <p>La CLI de Angular permite crear proyectos, componentes, servicios y más desde la terminal.</p>
      ${codeBlock("terminal", `<span class="kw">npm</span> install -g <span class="str">@angular/cli</span>`)}

      <h3>Crear un proyecto nuevo</h3>
      ${codeBlock("terminal", `<span class="kw">ng</span> new <span class="str">mi-aplicacion</span>\n<span class="kw">cd</span> mi-aplicacion\n<span class="kw">ng</span> serve`)}
      <p>La app estará disponible en <code>http://localhost:4200</code>.</p>

      <h3>Estructura del proyecto</h3>
      ${codeBlock("plaintext",
`src/
├── app/
│   ├── app.component.ts      <span class="cm">// Componente raíz</span>
│   ├── app.component.html    <span class="cm">// Template principal</span>
│   ├── app.component.css     <span class="cm">// Estilos del componente</span>
│   ├── app.config.ts         <span class="cm">// Configuración de la app</span>
│   └── app.routes.ts         <span class="cm">// Definición de rutas</span>
├── assets/                   <span class="cm">// Archivos estáticos</span>
├── index.html
├── main.ts                   <span class="cm">// Punto de entrada</span>
└── styles.css                <span class="cm">// Estilos globales</span>`)}

      <h3>Generar elementos con la CLI</h3>
      ${codeBlock("terminal",
`<span class="cm"># Componente</span>
<span class="kw">ng</span> generate component <span class="str">nombre</span>

<span class="cm"># Servicio</span>
<span class="kw">ng</span> generate service <span class="str">nombre</span>

<span class="cm"># Pipe</span>
<span class="kw">ng</span> generate pipe <span class="str">nombre</span>

<span class="cm"># Guard</span>
<span class="kw">ng</span> generate guard <span class="str">nombre</span>`)}

      <div class="ng-tip">Angular 17+ usa <strong>standalone components</strong> por defecto. Ya no es necesario declarar componentes en un módulo.</div>
    `,

    "components": () => `
      <h2>Componentes</h2>
      <p>Los componentes son la unidad básica de la interfaz en Angular. Cada componente tiene su lógica, template y estilos.</p>

      <h3>Componente standalone básico</h3>
      ${codeBlock("app.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Component</span>({
  <span class="fn">selector</span>: <span class="str">'app-saludo'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>,
  <span class="fn">template</span>: <span class="str">\`
    &lt;div class="card"&gt;
      &lt;h2&gt;Hola, {{ nombre }}&lt;/h2&gt;
      &lt;p&gt;Bienvenido a Angular&lt;/p&gt;
    &lt;/div&gt;
  \`</span>,
  <span class="fn">styles</span>: <span class="str">\`
    .card {
      padding: 1rem;
      border: 1px solid #ccc;
      border-radius: 8px;
    }
  \`</span>
})
<span class="kw">export class</span> <span class="tp">SaludoComponent</span> {
  nombre = <span class="str">'Abel'</span>;
}`)}

      <h3>Inputs y Outputs</h3>
      <p>Comunicación entre componentes padre e hijo.</p>
      ${codeBlock("hijo.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span>, <span class="tp">Input</span>, <span class="tp">Output</span>, <span class="tp">EventEmitter</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Component</span>({
  <span class="fn">selector</span>: <span class="str">'app-hijo'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>,
  <span class="fn">template</span>: <span class="str">\`
    &lt;button (click)="enviar()"&gt;
      {{ texto }}
    &lt;/button&gt;
  \`</span>
})
<span class="kw">export class</span> <span class="tp">HijoComponent</span> {
  <span class="dec">@Input</span>() texto = <span class="str">'Click'</span>;
  <span class="dec">@Output</span>() clicked = <span class="kw">new</span> <span class="tp">EventEmitter</span>&lt;<span class="tp">string</span>&gt;();

  <span class="fn">enviar</span>() {
    <span class="kw">this</span>.clicked.<span class="fn">emit</span>(<span class="str">'Evento del hijo'</span>);
  }
}`)}

      ${codeBlock("padre.component.html",
`<span class="cm">&lt;!-- Uso en el padre --&gt;</span>
<span class="tag">&lt;app-hijo</span>
  <span class="attr">[texto]</span>=<span class="val">"'Púlsame'"</span>
  <span class="attr">(clicked)</span>=<span class="val">"onHijoClicked($event)"</span>
<span class="tag">/&gt;</span>`)}

      <h3>Ciclo de vida</h3>
      ${codeBlock("lifecycle.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span>, <span class="tp">OnInit</span>, <span class="tp">OnDestroy</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="kw">export class</span> <span class="tp">MiComponent</span> <span class="kw">implements</span> <span class="tp">OnInit</span>, <span class="tp">OnDestroy</span> {
  <span class="fn">ngOnInit</span>() {
    <span class="cm">// Se ejecuta al iniciar el componente</span>
    console.<span class="fn">log</span>(<span class="str">'Componente iniciado'</span>);
  }

  <span class="fn">ngOnDestroy</span>() {
    <span class="cm">// Limpieza: desuscripciones, timers, etc.</span>
    console.<span class="fn">log</span>(<span class="str">'Componente destruido'</span>);
  }
}`)}
    `,

    "templates": () => `
      <h2>Templates</h2>
      <p>Angular usa su propio sistema de templates con sintaxis especial para binding de datos y control de flujo.</p>

      <h3>Interpolación y binding</h3>
      ${codeBlock("template.html",
`<span class="cm">&lt;!-- Interpolación --&gt;</span>
<span class="tag">&lt;h1&gt;</span>{{ titulo }}<span class="tag">&lt;/h1&gt;</span>

<span class="cm">&lt;!-- Property binding --&gt;</span>
<span class="tag">&lt;img</span> <span class="attr">[src]</span>=<span class="val">"imagenUrl"</span> <span class="attr">[alt]</span>=<span class="val">"descripcion"</span><span class="tag">&gt;</span>

<span class="cm">&lt;!-- Event binding --&gt;</span>
<span class="tag">&lt;button</span> <span class="attr">(click)</span>=<span class="val">"onClick()"</span><span class="tag">&gt;</span>Enviar<span class="tag">&lt;/button&gt;</span>

<span class="cm">&lt;!-- Two-way binding (requiere FormsModule) --&gt;</span>
<span class="tag">&lt;input</span> <span class="attr">[(ngModel)]</span>=<span class="val">"nombre"</span><span class="tag">&gt;</span>`)}

      <h3>Control de flujo (Angular 17+)</h3>
      <p>La nueva sintaxis de control de flujo reemplaza a <code>*ngIf</code>, <code>*ngFor</code> y <code>*ngSwitch</code>.</p>
      ${codeBlock("flow.html",
`<span class="cm">&lt;!-- Condicional --&gt;</span>
<span class="dec">@if</span> (usuario) {
  <span class="tag">&lt;p&gt;</span>Hola, {{ usuario.nombre }}<span class="tag">&lt;/p&gt;</span>
} <span class="dec">@else</span> {
  <span class="tag">&lt;p&gt;</span>No has iniciado sesión<span class="tag">&lt;/p&gt;</span>
}

<span class="cm">&lt;!-- Bucle --&gt;</span>
<span class="dec">@for</span> (item <span class="kw">of</span> items; <span class="kw">track</span> item.id) {
  <span class="tag">&lt;div&gt;</span>{{ item.nombre }}<span class="tag">&lt;/div&gt;</span>
} <span class="dec">@empty</span> {
  <span class="tag">&lt;p&gt;</span>No hay elementos<span class="tag">&lt;/p&gt;</span>
}

<span class="cm">&lt;!-- Switch --&gt;</span>
<span class="dec">@switch</span> (estado) {
  <span class="dec">@case</span> (<span class="str">'activo'</span>) { <span class="tag">&lt;span&gt;</span>Activo<span class="tag">&lt;/span&gt;</span> }
  <span class="dec">@case</span> (<span class="str">'inactivo'</span>) { <span class="tag">&lt;span&gt;</span>Inactivo<span class="tag">&lt;/span&gt;</span> }
  <span class="dec">@default</span> { <span class="tag">&lt;span&gt;</span>Desconocido<span class="tag">&lt;/span&gt;</span> }
}`)}

      <h3>Carga diferida</h3>
      ${codeBlock("defer.html",
`<span class="dec">@defer</span> (<span class="kw">on viewport</span>) {
  <span class="tag">&lt;app-comentarios</span> <span class="tag">/&gt;</span>
} <span class="dec">@placeholder</span> {
  <span class="tag">&lt;p&gt;</span>Cargando comentarios...<span class="tag">&lt;/p&gt;</span>
} <span class="dec">@loading</span> (<span class="kw">minimum</span> <span class="str">500ms</span>) {
  <span class="tag">&lt;app-spinner</span> <span class="tag">/&gt;</span>
}`)}
      <div class="ng-tip"><strong>@defer</strong> carga componentes de forma lazy automáticamente, mejorando el rendimiento inicial de la app.</div>
    `,

    "directives": () => `
      <h2>Directivas</h2>
      <p>Las directivas modifican el comportamiento o la apariencia de elementos del DOM.</p>

      <h3>Directiva de atributo personalizada</h3>
      ${codeBlock("highlight.directive.ts",
`<span class="kw">import</span> { <span class="tp">Directive</span>, <span class="tp">ElementRef</span>, <span class="tp">HostListener</span>, <span class="tp">Input</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Directive</span>({
  <span class="fn">selector</span>: <span class="str">'[appHighlight]'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>
})
<span class="kw">export class</span> <span class="tp">HighlightDirective</span> {
  <span class="dec">@Input</span>() appHighlight = <span class="str">'yellow'</span>;

  <span class="kw">constructor</span>(<span class="kw">private</span> el: <span class="tp">ElementRef</span>) {}

  <span class="dec">@HostListener</span>(<span class="str">'mouseenter'</span>)
  <span class="fn">onMouseEnter</span>() {
    <span class="kw">this</span>.el.nativeElement.style.backgroundColor
      = <span class="kw">this</span>.appHighlight;
  }

  <span class="dec">@HostListener</span>(<span class="str">'mouseleave'</span>)
  <span class="fn">onMouseLeave</span>() {
    <span class="kw">this</span>.el.nativeElement.style.backgroundColor
      = <span class="str">''</span>;
  }
}`)}

      ${codeBlock("uso.html",
`<span class="tag">&lt;p</span> <span class="attr">[appHighlight]</span>=<span class="val">"'#e0f7fa'"</span><span class="tag">&gt;</span>
  Pasa el ratón por encima
<span class="tag">&lt;/p&gt;</span>`)}

      <h3>Directiva estructural personalizada</h3>
      ${codeBlock("unless.directive.ts",
`<span class="kw">import</span> { <span class="tp">Directive</span>, <span class="tp">Input</span>, <span class="tp">TemplateRef</span>, <span class="tp">ViewContainerRef</span> }
  <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Directive</span>({
  <span class="fn">selector</span>: <span class="str">'[appUnless]'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>
})
<span class="kw">export class</span> <span class="tp">UnlessDirective</span> {
  <span class="dec">@Input</span>() <span class="kw">set</span> <span class="fn">appUnless</span>(condition: <span class="tp">boolean</span>) {
    <span class="kw">if</span> (!condition) {
      <span class="kw">this</span>.vc.<span class="fn">createEmbeddedView</span>(<span class="kw">this</span>.tpl);
    } <span class="kw">else</span> {
      <span class="kw">this</span>.vc.<span class="fn">clear</span>();
    }
  }

  <span class="kw">constructor</span>(
    <span class="kw">private</span> tpl: <span class="tp">TemplateRef</span>&lt;<span class="tp">any</span>&gt;,
    <span class="kw">private</span> vc: <span class="tp">ViewContainerRef</span>
  ) {}
}`)}
    `,

    "services": () => `
      <h2>Servicios e Inyección de dependencias</h2>
      <p>Los servicios encapsulan lógica reutilizable y se inyectan donde se necesiten.</p>

      <h3>Crear un servicio</h3>
      ${codeBlock("user.service.ts",
`<span class="kw">import</span> { <span class="tp">Injectable</span> } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Injectable</span>({
  <span class="fn">providedIn</span>: <span class="str">'root'</span>  <span class="cm">// Disponible en toda la app</span>
})
<span class="kw">export class</span> <span class="tp">UserService</span> {
  <span class="kw">private</span> users: <span class="tp">string</span>[] = [];

  <span class="fn">getUsers</span>(): <span class="tp">string</span>[] {
    <span class="kw">return</span> <span class="kw">this</span>.users;
  }

  <span class="fn">addUser</span>(name: <span class="tp">string</span>): <span class="tp">void</span> {
    <span class="kw">this</span>.users.<span class="fn">push</span>(name);
  }
}`)}

      <h3>Inyectar en un componente</h3>
