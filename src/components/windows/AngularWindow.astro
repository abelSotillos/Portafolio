`<span class="cm">&lt;!-- Texto --&gt;</span>
<span class="tag">&lt;p&gt;</span>{{ <span class="str">'hola mundo'</span> | <span class="fn">uppercase</span> }}<span class="tag">&lt;/p&gt;</span>
