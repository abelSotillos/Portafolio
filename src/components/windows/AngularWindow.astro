`<span class="kw">import</span> { <span class="tp">HttpInterceptorFn</span> } <span class="kw">from</span> <span class="str">'@angular/common/http'</span>;

<span class="kw">export const</span> <span class="fn">authInterceptor</span>: <span class="tp">HttpInterceptorFn</span> =
  (req, next) => {
    <span class="kw">const</span> token = localStorage.<span class="fn">getItem</span>(<span class="str">'token'</span>);

