  <!-- ── SIDEBAR TOGGLE BAR (mobile) ── -->
  <div class="ng-topbar" id="ng-topbar">
    <button class="ng-sidebar-toggle" id="ng-sidebar-toggle" aria-label="Menú">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
    </button>
    <span class="ng-topbar-title" id="ng-topbar-title">Primeros pasos</span>
  </div>
  <div class="ng-sidebar-overlay hidden" id="ng-sidebar-overlay"></div>

  <!-- ── SIDEBAR ── -->
  <div class="ng-sidebar" id="ng-sidebar">
