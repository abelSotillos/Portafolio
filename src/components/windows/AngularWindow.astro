})
<span class="kw">export class</span> <span class="tp">RegistroComponent</span> {
  <span class="kw">private</span> fb = <span class="fn">inject</span>(<span class="tp">FormBuilder</span>);

  form = <span class="kw">this</span>.fb.<span class="fn">group</span>({
