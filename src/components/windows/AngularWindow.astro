    "signals": () => `
      <h2>Signals</h2>
      <p>Los Signals son el nuevo sistema de reactividad de Angular (v16+). Permiten gestionar estado de forma sencilla y eficiente.</p>

      <h3>Signal básico</h3>
      ${codeBlock("counter.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span>, <span class="fn">signal</span>, <span class="fn">computed</span> }
  <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Component</span>({
  <span class="fn">selector</span>: <span class="str">'app-counter'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>,
  <span class="fn">template</span>: <span class="str">\`
    &lt;p&gt;Contador: {{ count() }}&lt;/p&gt;
    &lt;p&gt;Doble: {{ doble() }}&lt;/p&gt;
    &lt;button (click)="incrementar()"&gt;+1&lt;/button&gt;
    &lt;button (click)="resetear()"&gt;Reset&lt;/button&gt;
  \`</span>
})
<span class="kw">export class</span> <span class="tp">CounterComponent</span> {
  <span class="cm">// Signal: valor reactivo</span>
  count = <span class="fn">signal</span>(<span class="str">0</span>);

  <span class="cm">// Computed: derivado de otros signals</span>
  doble = <span class="fn">computed</span>(() => <span class="kw">this</span>.count() * <span class="str">2</span>);

  <span class="fn">incrementar</span>() {
    <span class="kw">this</span>.count.<span class="fn">update</span>(n => n + <span class="str">1</span>);
  }

  <span class="fn">resetear</span>() {
    <span class="kw">this</span>.count.<span class="fn">set</span>(<span class="str">0</span>);
  }
}`)}

      <h3>Effect</h3>
      <p>Ejecuta código cuando cambian los signals que lee.</p>
      ${codeBlock("logger.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span>, <span class="fn">signal</span>, <span class="fn">effect</span> }
  <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="kw">export class</span> <span class="tp">LoggerComponent</span> {
  query = <span class="fn">signal</span>(<span class="str">''</span>);

  <span class="kw">constructor</span>() {
    <span class="cm">// Se ejecuta cada vez que query() cambie</span>
    <span class="fn">effect</span>(() => {
      console.<span class="fn">log</span>(
        <span class="str">'Buscando:'</span>, <span class="kw">this</span>.query()
      );
    });
  }
}`)}

      <h3>Signal inputs (Angular 17.1+)</h3>
      ${codeBlock("card.component.ts",
`<span class="kw">import</span> { <span class="tp">Component</span>, <span class="fn">input</span>, <span class="fn">computed</span> }
  <span class="kw">from</span> <span class="str">'@angular/core'</span>;

<span class="dec">@Component</span>({
  <span class="fn">selector</span>: <span class="str">'app-card'</span>,
  <span class="fn">standalone</span>: <span class="tp">true</span>,
  <span class="fn">template</span>: <span class="str">\`
    &lt;div [class]="cssClass()"&gt;
      {{ title() }}
    &lt;/div&gt;
  \`</span>
})
<span class="kw">export class</span> <span class="tp">CardComponent</span> {
  <span class="cm">// Input como signal (reemplaza @Input())</span>
  title = <span class="fn">input</span>(<span class="str">'Sin título'</span>);
  type  = <span class="fn">input</span>&lt;<span class="str">'info'</span> | <span class="str">'warn'</span>&gt;(<span class="str">'info'</span>);

  <span class="cm">// Required input</span>
  id = <span class="fn">input</span>.<span class="fn">required</span>&lt;<span class="tp">number</span>&gt;();

  cssClass = <span class="fn">computed</span>(
    () => <span class="str">\`card card-\${this.type()}\`</span>
  );
}`)}

      <div class="ng-tip">Los signals son la base de la nueva detección de cambios de Angular. Usa <code>signal()</code> para estado local, <code>computed()</code> para valores derivados y <code>effect()</code> para side effects.</div>
    `,

    "pipes": () => `
      <h2>Pipes</h2>
